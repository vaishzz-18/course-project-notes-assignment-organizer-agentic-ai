# AURA Academic Platform — Environment Configuration Template
# Duplicate this file to .env and configure for your deployment.

# Deployment Environment: development | production | test
ENVIRONMENT=development

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Application Security
SECRET_KEY=generate-a-secure-random-256-bit-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default is SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///data/organizer.db
# For PostgreSQL in production, set:
# POSTGRES_URL=postgresql+asyncpg://aura_user:aura_secure_password@localhost:5432/aura_db

# Model Context Protocol (MCP) Configuration
MCP_SERVER_URL=http://localhost:8001
MCP_AUTH_TOKEN=aura-governed-mcp-token-2026

# Object Storage (S3 / MinIO) Configuration
# Default is "local" (uses local filesystem data/ directory)
STORAGE_BACKEND=local
# For MinIO or AWS S3, set:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_NOTES=aura-notes
# S3_BUCKET_SUBMISSIONS=aura-submissions

# Redis Background Worker (Celery / Background Tasks)
# REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Academic Safety Policies & Thresholds
SIMILARITY_THRESHOLD=0.75
MAX_VALIDATION_ATTEMPTS=3
MAX_GRADING_RETRIES=3
